#!/bin/sh
# Launcher for the MCP server. Point your MCP config at this, not at `node server.mjs`:
# it locates node even when the client was started without a login shell.
set -e
HERE=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$HERE/bin/_find-node.sh"

NODE=$(find_node)
if [ -z "$NODE" ]; then
  echo "sociair-cards-mcp: could not find node. Install Node >= 18, or set NODE_BIN." >&2
  exit 127
fi

exec "$NODE" "$HERE/server.mjs" "$@"
