# Personal credentials for sociair-cards-mcp. Keep this file private (chmod 600).
SOCIAIR_API_BASE=https://new-central-api.sociair.com/api
SOCIAIR_ORIGIN=https://onewindow.sociair.io
SOCIAIR_FISCAL_YEAR_ID=4
SOCIAIR_TOKEN=paste-your-bearer-token-here

# Writes are off by default. Set to 1 to let move_card / add_card_comment change CRM data.
SOCIAIR_ALLOW_WRITES=0
